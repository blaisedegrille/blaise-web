---
interface Props {
  copyright?: string;
}

const { copyright } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 py-6 text-center text-sm text-zinc-600 dark:border-zinc-800 dark:text-zinc-400">
  <p>{copyright ?? `© ${year} Blaise. All rights reserved.`}</p>
</footer>
