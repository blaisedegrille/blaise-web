---
import { withBase } from '../lib/utils';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  siteName?: string;
}

const { siteName = 'Blaise' } = Astro.props;

const links = [
  { label: 'Home', href: withBase('/') },
  { label: 'Blog', href: withBase('/blog') },
];
---

<header class="border-b border-zinc-200 dark:border-zinc-800">
  <nav class="mx-auto flex w-full max-w-3xl items-center justify-between px-6 py-4">
    <a href={withBase('/')} class="text-lg font-semibold">{siteName}</a>
    <div class="flex items-center gap-6">
      <ul class="flex items-center gap-6">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
