---
import type { CollectionEntry } from 'astro:content';
import { formatDate, withBase } from '../lib/utils';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const href = withBase(`/blog/${post.id}/`);
---

<article
  class="rounded-lg border border-zinc-200 p-5 transition-colors hover:border-accent/40 dark:border-zinc-800 dark:hover:border-accent/40"
>
  <h2 class="text-xl font-semibold">
    <a
      href={href}
      class="transition-colors hover:text-accent"
    >{post.data.title}</a>
  </h2>
  <time datetime={post.data.published.toISOString()} class="text-sm text-zinc-500 dark:text-zinc-400">
    {formatDate(post.data.published)}
  </time>
  {post.data.description && <p class="mt-2 text-zinc-600 dark:text-zinc-300">{post.data.description}</p>}
  {
    post.data.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</article>
