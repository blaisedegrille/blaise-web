---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  class:list={['rounded-md p-2 text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100', className]}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <title>Theme toggle</title>
    <mask id="moon-mask">
      <rect x="0" y="0" width="24" height="24" fill="white" />
      <circle cx="16" cy="8" r="6" fill="black" />
    </mask>
    <circle cx="12" cy="12" r="8" fill="currentColor" mask="url(#moon-mask)" />
  </svg>
</button>

<script>
  const toggle = document.getElementById('theme-toggle');

  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
