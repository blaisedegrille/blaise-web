---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { withBase } from '../lib/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  tags?: string[];
}

const { title, description, image, tags = [] } = Astro.props;
const siteName = 'Blaise';
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? `${siteName} — personal site`} />
    <meta name="generator" content={Astro.generator} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
    <script is:inline>
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || (!stored && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body
    class="isolate flex min-h-screen flex-col bg-white text-zinc-900 antialiased selection:bg-accent/20 dark:bg-zinc-950 dark:text-zinc-100"
  >
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div
        class="absolute -top-40 left-1/2 h-[30rem] w-[60rem] -translate-x-1/2 rounded-full bg-aqua/20 blur-[140px] dark:bg-aqua/25"
      >
      </div>
      <div
        class="absolute top-[30%] -left-48 h-96 w-96 rounded-full bg-yellow/15 blur-[120px] dark:bg-yellow/20"
      >
      </div>
      <div
        class="absolute -right-48 -bottom-40 h-96 w-96 rounded-full bg-pink/20 blur-[120px] dark:bg-pink/25"
      >
      </div>
      <div
        class="absolute -bottom-52 left-1/4 h-96 w-[40rem] rounded-full bg-purple/15 blur-[130px] dark:bg-purple/20"
      >
      </div>
    </div>
    <Header />
    <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
