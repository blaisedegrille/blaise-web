---
import { Image } from 'astro:assets';
import meBw from '../assets/me-bw.jpeg';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About Blaise — who I am and how to reach me.">
  <section class="py-16">
    <div class="flex flex-col items-start gap-8 sm:flex-row sm:items-center">
      <Image
        src={meBw}
        alt="Black-and-white portrait of Blaise"
        width={320}
        densities={[1, 2]}
        class="w-40 rounded-2xl shadow-lg ring-1 ring-zinc-200 sm:w-48 dark:ring-zinc-800"
        loading="eager"
      />
      <div>
        <h1 class="text-3xl font-bold tracking-tight">About me</h1>
        <p class="mt-4 text-zinc-600 dark:text-zinc-300">
          Hi, I'm Blaise. I build for the web and enjoy the craft of making simple things work
          well. This site is where I share what I'm learning and building — mostly around web
          development.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-16">
    <h2 class="text-2xl font-bold tracking-tight">Contact</h2>
    <p class="mt-3 text-zinc-600 dark:text-zinc-300">
      The easiest way to reach me is on GitHub — my inbox there is always open for ideas,
      questions, or just saying hi.
    </p>
    <a
      href="https://github.com/blaisedegrille"
      rel="noopener noreferrer"
      target="_blank"
      class="mt-4 inline-flex items-center gap-2 rounded-md border border-zinc-200 px-4 py-2 font-medium transition-colors hover:border-accent/40 hover:text-accent dark:border-zinc-800 dark:hover:border-accent/40 dark:hover:text-accent"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <title>GitHub</title>
        <path
          d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
        />
      </svg>
      github.com/blaisedegrille
    </a>
  </section>
</BaseLayout>
