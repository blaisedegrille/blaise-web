---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
---

<BaseLayout title="Blog" description="Posts and thoughts">
  <h1 class="text-3xl font-bold tracking-tight">Blog</h1>
  <p class="mt-2 text-zinc-600 dark:text-zinc-300">Posts and thoughts.</p>

  <div class="mt-8 flex flex-col gap-4">
    {posts.map((post) => <PostCard post={post} />)}
    {
      posts.length === 0 && (
        <p class="text-zinc-500 dark:text-zinc-400">No posts yet. Check back soon.</p>
      )
    }
  </div>
</BaseLayout>
